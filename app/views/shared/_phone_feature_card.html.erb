<% first, rest = t("landing.features.items.#{key}.title").split(" ", 2) %>

<div
  class="relative h-[65.6cqw] shrink-0 overflow-hidden rounded-[4.1cqw] bg-black shadow-lg ring-2 ring-white/10 will-change-transform"
  data-phone-stage-target="card"
  data-from="<%= from %>"
>
  <img
    src="<%= asset_path(key + '.webp') %>"
    alt="<%= t("landing.features.items.#{key}.title") %>"
    class="absolute inset-0 h-full w-full object-cover"
  />

  <!-- Legibility overlay, darkest on the left where the text sits -->
  <div class="absolute inset-0 bg-gradient-to-r from-black via-black/70 to-transparent"></div>

  <!-- Text overlay, on the left -->
  <div class="relative z-10 flex h-full w-3/4 flex-col justify-center p-[6.2cqw]">
    <h3 class="font-display uppercase leading-none tracking-tight text-[6.2cqw]">
      <span class="text-primary-600"><%= first %></span>
      <% if rest.present? %>
        <br />
        <span class="text-white"><%= rest %></span>
      <% end %>
    </h3>

    <div class="my-[2cqw] h-[1cqw] w-[12.3cqw] bg-primary-600"></div>

    <p class="text-[3.6cqw] leading-relaxed text-dark-text-muted">
      <%= t("landing.features.items.#{key}.description") %>
    </p>
  </div>
</div>
