<section class="relative py-24 min-h-screen bg-dark-background">
  <!-- Background Pattern -->
  <div class="absolute inset-0">
    <div class=" relative h-full w-full">
      <div
        class="absolute bottom-0 right-0 z[-2] h-full w-full"></div>

    </div>
  </div>

  <div class="relative z-10 flex min-h-screen flex-col justify-center">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2
          class="
            font-display text-4xl md:text-5xl font-extrabold text-primary-600 mb-4
          "
        >
          <%= t("landing.features.main_title") %>
        </h2>
        <p class="text-xl text-dark-text max-w-3xl mx-auto">
          <%= t("landing.features.main_subtitle") %>
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 lg:grid-cols-2 gap-8">
        <% features.each_with_index do |feature_key, index| %>
          <%= render "shared/feature_card", key: feature_key, index: index %>
        <% end %>
      </div>
    </div>
  </div>
</section>
