<section class="relative min-h-screen overflow-hidden bg-dark-background" data-controller="parallax">
  <!-- Hero Content -->
  <div
    class="
      relative z-10 min-h-screen flex flex-col-reverse items-center justify-center gap-y-24
      px-6 pt-28 pb-16
      min-[1172px]:flex-row min-[1172px]:items-center min-[1172px]:justify-between
      min-[1172px]:gap-x-12 min-[1172px]:gap-y-4 min-[1172px]:py-12
    "
  >
    <div
      class="
        relative flex flex-col flex-grow items-center min-[1172px]:items-end justify-center
        transition duration-700 ease-out will-change-transform
      "
      data-parallax-target="phone"
      data-parallax-from="left"
    >
      <img src="<%= asset_path("preview-#{I18n.locale}.webp") %>" alt="App Preview" class="relative z-10 h-[32rem] sm:h-[40rem] lg:h-[48rem] min-[1172px]:h-200 animate-float">
    </div>

    <div
      class="
        flex flex-col flex-grow items-center min-[1172px]:items-start justify-center
        min-[1172px]:min-h-screen
        transition duration-700 ease-out will-change-transform
      "
      data-parallax-target="content"
      data-parallax-from="right"
    >
      <div class="flex flex-col items-center justify-center text-center min-[1172px]:items-start min-[1172px]:text-left">
        <img src="<%= asset_path('ElRingNegative.svg') %>" alt="<%= app_name %> Logo" class="h-32 sm:h-40 min-[1172px]:h-52 mb-8">

        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-dark-text">
          <%= t("landing.hero.headline") %>
        </h1>

        <div class="mt-5 h-1 w-16 bg-primary-600"></div>

        <p class="mt-6 text-lg text-gray-400 mb-8 max-w-2xl leading-relaxed">
          <%= t("landing.hero.description") %>
        </p>

        <div class="flex flex-col items-center min-[1172px]:items-start gap-4">
          <span
            class="
              inline-flex items-center gap-2 rounded-full bg-primary-600 px-4 py-1.5
              text-sm font-semibold uppercase tracking-widest text-white
            "
          >
            <%= t("landing.hero.coming_soon_headline") %>
          </span>
          <p class="text-gray-400">
            <%= t("landing.hero.coming_soon_description") %>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
