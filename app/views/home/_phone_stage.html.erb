<section data-controller="phone-stage" class="relative bg-dark-background">
  <!-- Tall scroll track drives the sequence -->
  <div data-phone-stage-target="track" class="relative h-[600vh]">
    <!-- Sticky viewport: phone stays centered while the track scrolls past -->
    <div class="sticky top-0 flex h-[100svh] items-center justify-center overflow-hidden">
      <!-- Ambient red glow -->
      <div class="pointer-events-none absolute inset-0">
        <div
          class="
            absolute left-1/2 top-1/2 h-[36rem] w-[36rem] -translate-x-1/2 -translate-y-1/2
            rounded-full bg-primary-600/15 blur-[120px]
          "
        ></div>
      </div>

      <!-- Phone: a real device frame image (phone_frame.png) with the screen cut
           out; the app content sits behind it and shows through the hole. -->
      <div
        data-phone-stage-target="phone"
        class="
          relative z-10 origin-center will-change-transform aspect-[1141/2348]
          h-[92svh] min-[500px]:h-[88vh] min-[500px]:max-h-[880px]
        "
      >
        <!-- Screen content, tucked just under the frame bezel so no gap shows -->
        <div
          data-phone-stage-target="screen"
          class="absolute overflow-hidden bg-black"
          style="top:4.6%;bottom:5%;left:2.6%;right:2.7%;border-radius:7%/3.2%;"
        >

          <!-- ============ Screen 0: Hero ============ -->
          <div
            data-phone-stage-target="heroScreen"
            class="absolute inset-0 flex flex-col items-center justify-center bg-white px-8 text-center"
          >
            <img src="<%= asset_path('ElRing.svg') %>" alt="<%= app_name %> Logo" class="h-28 mb-12">

            <h2 class="text-3xl font-display text-secondary-600">
              <%= t("landing.hero.headline") %>
            </h2>

            <div class="my-2 h-1 w-20 bg-primary-600"></div>

            <p class="text-md leading-relaxed text-secondary-400">
              <%= t("landing.hero.description") %>
            </p>

            <span
              class="
                mt-12 inline-flex items-center rounded-full bg-primary-600 px-4 py-1.5
                text-sm font-semibold uppercase tracking-widest text-white
              "
            >
              <%= t("landing.hero.coming_soon_headline") %>
            </span>
            <p class="mt-3 text-sm text-secondary-400">
              <%= t("landing.hero.coming_soon_description") %>
            </p>

            <!-- Scroll-down hint -->
            <div class="absolute inset-x-0 bottom-6 flex flex-col justify-center items-center text-secondary-400 animate-bounce">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
              <p>scroll</p>
            </div>
          </div>

          <!-- ============ Features screen ============ -->
          <div
            data-phone-stage-target="featuresScreen"
            class="absolute inset-0 opacity-0"
          >
            <!-- Feed: the title and cards all scroll within the screen -->
            <div class="absolute inset-0 overflow-hidden">
              <div
                data-phone-stage-target="list"
                class="flex flex-col gap-6 px-4 pt-10 pb-8 will-change-transform"
              >
                <!-- Section title scrolls along with the cards -->
                <div class="px-1">
                  <h2 class="font-display text-3xl uppercase leading-none text-white">
                    <%= t("landing.features.main_title") %>
                  </h2>
                  <div class="mt-2 h-1 w-10 bg-primary-600"></div>
                  <p class="mt-2 text-md leading-snug text-dark-text-muted">
                    <%= t("landing.features.main_subtitle") %>
                  </p>
                </div>

                <% features.each_with_index do |feature_key, i| %>
                  <%= render "shared/phone_feature_card",
                        key: feature_key, from: (i.even? ? "left" : "right") %>
                <% end %>

                <!-- Newsletter CTA closes the feed; fills a full phone screen -->
                <div
                  data-phone-stage-target="cta"
                  class="flex flex-col px-4 text-center"
                >
                  <!-- Centered signup -->
                  <div class="flex flex-1 flex-col items-center justify-center">
                    <h3 class="font-display text-3xl uppercase leading-none text-white">
                      <%= t("landing.cta.title") %>
                    </h3>
                    <div class="my-4 h-1 w-18 bg-primary-600"></div>
                    <p class="text-sm leading-relaxed text-gray-400">
                      <%= t("landing.cta.description") %>
                    </p>
                    <div class="mt-5 w-full max-w-xs">
                      <%= render "newsletter_subscriptions/form", subscription: @subscription %>
                    </div>
                  </div>

                  <!-- Fine print pinned to the bottom of the CTA screen (all widths). -->
                  <div class="pb-6 pt-4 text-sm text-dark-text-muted">
                    <div class="flex flex-wrap justify-center gap-x-3 gap-y-1">
                      <%= link_to t("landing.cta.footer.privacy_policy"),
                            policy_privacy_path, class: "hover:text-text-contrast transition-colors" %>
                      <%= link_to t("landing.cta.footer.terms_and_conditions"),
                            policy_terms_path, class: "hover:text-text-contrast transition-colors" %>
                    </div>
                    <p class="mt-2 text-sm">
                      <%= t("landing.cta.footer.copyright", company_name: company_name) %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
        <!-- /screen content -->

        <!-- Device frame on top (screen area is transparent); fades out on mobile
             as the screen grows to fullscreen. -->
        <%= image_tag "phone_frame.png", alt: "", aria: { hidden: true },
              data: { "phone-stage-target": "frame" },
              class: "pointer-events-none absolute inset-0 h-full w-full select-none" %>
      </div>
      <!-- /phone -->
    </div>
  </div>
</section>
